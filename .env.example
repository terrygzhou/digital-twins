# digital-twins — environment layer (highest precedence)
# Copy to .env (machine-local, never committed) and fill in.
# KB_ prefix; `__` = nesting. Values here win over kb.local.yml / kb.yml.

# --- Global ---
#KB_STATE_DIR=
#KB_CONFIG_DIR=

# --- Endpoints ---
#KB_QDRANT__URL=http://localhost:6333
#KB_QDRANT__API_KEY=
#KB_NEO4J__URL=bolt://localhost:7687
#KB_NEO4J__USER=neo4j
#KB_NEO4J__PASSWORD=
#KB_LLM__ENDPOINT=http://localhost:8000/v1
#KB_LLM__MODEL=
#KB_LLM__API_KEY=

# --- Embedding ---
#KB_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
#KB_EMBEDDING__DEVICE=cpu

# --- Chunking ---
#KB_CHUNKING__MAX_CHARS=800
#KB_CHUNKING__OVERLAP=100

# --- Scheduler ---
#KB_SCHEDULER__STATUS_PORT=8765

# --- MCP ---
#KB_MCP__PORT=8770
#KB_MCP__SERVICE_ACCOUNT_EMAIL=system

# --- Sources (per-source overrides) ---
#KB_SOURCES__HERMES__ENABLED=false
#KB_SOURCES__HERMES__MAX_ITEMS=200
#KB_SOURCES__HERMES__TIMEOUT_S=1500
#KB_SOURCES__PI__ENABLED=false
#KB_SOURCES__PI__MAX_ITEMS=200
#KB_SOURCES__PI__TIMEOUT_S=1500
#KB_SOURCES__DSH__ENABLED=false
#KB_SOURCES__DSH__MAX_ITEMS=200
#KB_SOURCES__DSH__TIMEOUT_S=1500
#KB_SOURCES__PAPERCLIP__ENABLED=false
#KB_SOURCES__PAPERCLIP__MAX_ITEMS=200
#KB_SOURCES__PAPERCLIP__TIMEOUT_S=1500
#KB_SOURCES__YAHOO__ENABLED=false
#KB_SOURCES__YAHOO__MAX_ITEMS=200
#KB_SOURCES__YAHOO__TIMEOUT_S=1500
#KB_SOURCES__GMAIL__ENABLED=false
#KB_SOURCES__GMAIL__MAX_ITEMS=200
#KB_SOURCES__GMAIL__TIMEOUT_S=1500
#KB_SOURCES__FS__ENABLED=false
#KB_SOURCES__FS__MAX_ITEMS=200
#KB_SOURCES__FS__TIMEOUT_S=1500

# --- Source credentials (referenced by name in config; values never in kb.yml) ---
# IMAP mail sources: the account address (yahoo/gmail) is taken from these vars.
#YMAIL_EMAIL=you@example.com
#GMAIL_EMAIL=you@example.com
# IMAP app passwords / API tokens (per-source credential env var):
#YMAIL_APP_PASSWORD=
#GMAIL_APP_PASSWORD=
#MYTOOL_TOKEN=
