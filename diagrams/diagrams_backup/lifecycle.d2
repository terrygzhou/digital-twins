direction: right;

# ── Phase 0: configuration (the substrate) ─────────────────────────────
config {
  label: "config /\n4-layer load\nenv(.env) → local → yml → defaults";
  style: {
    stroke: "#4f9cf7";
    font-size: 14;
  }
}

# ── Phase 1: ingestion (read from sources) ─────────────────────────────
sources {
  label: "sources (8)";
  style: { stroke: "#f7a04f"; }
}
sources.fs { label: "fs: directory of files"; }
sources.hermes { label: "hermes: session export"; }
sources.pi { label: "pi: session store .jsonl"; }
sources.dsh { label: "dsh: .jsonl.zstd sessions"; }
sources.paperclip { label: "paperclip: PG DB"; }
sources.mail { label: "yahoo / gmail: IMAP"; }
sources.custom { label: "custom: entrypoint"; }

# ── Phase 2: transformation (chunk + embed) ────────────────────────────
ingest {
  label: "ingest";
  style: { stroke: "#9b59b6"; }
}
ingest.prereq {
  label: "fail-fast prereq check";
  shape: diamond;
}
ingest.chunk { label: "chunk_text (max_chars, overlap)"; }
ingest.embed { label: "embedder (endpoint or pinned BGE)"; }
ingest.ids {
  label: "deterministic point_id (uuid5)";
  shape: diamond;
}

# ── Phase 3: storage (upsert + state) ──────────────────────────────────
store {
  label: "store";
  style: { stroke: "#27ae60"; }
}
store.qdrant {
  label: "Qdrant (vectors, payload)";
  shape: cylinder;
}
store.neo4j {
  label: "Neo4j (graph, optional)";
  shape: cylinder;
}
store.sqlite {
  label: "SQLite (WAL) — highwater + audit_runs";
  shape: cylinder;
}

# ── Phase 4: scheduling (wraps 1–3) ────────────────────────────────────
sched {
  label: "scheduler/";
  style: { stroke: "#e74c3c"; }
}
sched.presets { label: "presets (daily/hourly/weekly/monthly/N)"; }
sched.loop { label: "serve loop + pidfile, tick ~3s"; }

# ── Phase 5: retrieval / serving (read side) ───────────────────────────
serve {
  label: "serving";
  style: { stroke: "#16a2b3"; }
}
serve.web { label: "web/ /api/* (search, ingest, audit)"; }
serve.mcp { label: "mcp/ stdio + http (kb_search, kb_ingest, …)"; }
serve.search {
  label: "owner-scoped vector search";
  shape: diamond;
}

# ── Phase 7: audit & multi-user (cross-cutting) ───────────────────────
audit { label: "audit_runs — row per run (ok/partial/failed)"; }
multi { label: "multi-user auth (sessions, tokens, roles)"; }

# ── data flow ───────────────────────────────────────────────────────────
config -> sources: "resolved cfg";
sources -> ingest.prereq: "IngestItem (key, content, ts)";
ingest.prereq -> ingest.chunk: "ok";
ingest.prereq -> ingest.chunk: "PrerequisiteError → exit 2, audited failed" {
  style: {
    stroke-dash: 5;
    stroke: "#e74c3c";
  }
}
ingest.chunk -> ingest.embed: "chunk text";
ingest.embed -> ingest.ids: "vectors";
ingest.ids -> store.qdrant: "upsert point (dedup: NFR-1)";
ingest.ids -> store.neo4j: "MERGE nodes";
store.qdrant -> store.sqlite: "highwater cursor";
store.qdrant -> serve.search;
store.sqlite -> audit;

# scheduling drives the pipeline
sched.loop -> ingest.prereq: "fire due, trigger=schedule";
sched.presets -> sched.loop: "next_fire_at";

# serving surfaces
serve.web -> serve.search: "Bearer session";
serve.mcp -> serve.search: "role-gate + owner-scope";
serve.web -> ingest.prereq: "POST /api/ingest/run, trigger=web";
serve.mcp -> ingest.prereq: "kb_ingest, trigger=mcp";

# multi-user wraps serving
multi -> serve.web;
multi -> serve.mcp;

style: {
  font-size: 14;
  border-radius: 8;
}
